{
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(xcodegen:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(swift:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python3:*)",
