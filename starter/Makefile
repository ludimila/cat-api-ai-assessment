SHELL := /bin/bash

DEVELOPER_DIR ?= /Applications/Xcode.app/Contents/Developer
export DEVELOPER_DIR

SCHEME      := CatBudget
SIMULATOR   ?= iPhone 17
DESTINATION := platform=iOS Simulator,name=$(SIMULATOR)
ENV_FILE    := ../.env
XCCONFIG    := Secrets.xcconfig

.PHONY: help generate build test run clean

help:
	@echo "make generate  Write Secrets.xcconfig from ../.env and run xcodegen"
	@echo "make build     Build the app for the iOS Simulator"
	@echo "make test      Run the unit tests"
	@echo "make run       Build, install and launch on the booted simulator"
	@echo "make clean     Remove generated project and build output"

# The key is read from either layout:
#   ../.env        a file containing CAT_API_KEY=...
#   ../.env/cat    a directory holding the bare key in a file named `cat`
$(XCCONFIG):
	@key=""; \
	if [ -f "$(ENV_FILE)" ]; then \
		key=$$(grep -E '^CAT_API_KEY=' "$(ENV_FILE)" | head -1 | cut -d= -f2-); \
	elif [ -f "$(ENV_FILE)/cat" ]; then \
		key=$$(head -1 "$(ENV_FILE)/cat"); \
	fi; \
	key=$$(echo "$$key" | tr -d '"'"'"' \r'); \
	if [ -z "$$key" ] || [ "$$key" = "your-key-here" ]; then \
		echo "ERROR: no Cat API key found."; \
		echo "Put the bare key in $(ENV_FILE)/cat,"; \
		echo "or CAT_API_KEY=... in $(ENV_FILE) (see ../.env.example)."; \
		echo "Without a key the app falls back to Fixtures/breeds.json."; \
		exit 1; \
	fi; \
	printf '// Generated by make. Do not commit.\nCAT_API_KEY = %s\n' "$$key" > $(XCCONFIG); \
	echo "Wrote $(XCCONFIG)"

generate: $(XCCONFIG)
	@xcodegen generate --quiet
	@echo "Generated CatBudget.xcodeproj"

build: generate
	@xcodebuild build \
		-project CatBudget.xcodeproj \
		-scheme $(SCHEME) \
		-destination '$(DESTINATION)' \
		-quiet

test: generate
	@xcodebuild test \
		-project CatBudget.xcodeproj \
		-scheme $(SCHEME) \
		-destination '$(DESTINATION)'

run: build
	@xcrun simctl boot "$(SIMULATOR)" 2>/dev/null || true
	@open -a Simulator
	@app=$$(xcodebuild -project CatBudget.xcodeproj -scheme $(SCHEME) \
		-destination '$(DESTINATION)' -showBuildSettings 2>/dev/null \
		| awk -F' = ' '/ BUILT_PRODUCTS_DIR /{d=$$2} / FULL_PRODUCT_NAME /{n=$$2} END{print d"/"n}'); \
	xcrun simctl install booted "$$app"; \
	xcrun simctl launch booted com.assessment.CatBudget

clean:
	@rm -rf CatBudget.xcodeproj Support/Info.plist build
	@echo "Cleaned"
